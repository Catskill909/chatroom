# All-in-one image: Node app + MongoDB in a single container
# Build stage
FROM node:20-bookworm AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build

# Runtime stage with MongoDB + Supervisor
FROM node:20-jammy
WORKDIR /app

# Install dependencies: curl, ca-certificates, supervisor
# Plus MongoDB runtime libs commonly required by the tarball on Ubuntu Jammy
# and netcat for simple health checks
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl supervisor \
        libcurl4 liblzma5 libsnappy1v5 libzstd1 libssl3 libgcc-s1 libstdc++6 \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install MongoDB (binaries) into /opt/mongodb
# Detect architecture to fetch the correct tarball (amd64 -> x86_64, arm64 -> aarch64)
ENV MONGODB_VERSION=7.0.12
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) mongo_arch="x86_64" ;; \
      arm64) mongo_arch="aarch64" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac; \
    base="ubuntu2204"; \
    mkdir -p /opt/mongodb /data/db; \
    url="https://fastdl.mongodb.org/linux/mongodb-linux-${mongo_arch}-${base}-${MONGODB_VERSION}.tgz"; \
    echo "Downloading ${url}"; \
    curl -fsSL "$url" -o /tmp/mongodb.tgz; \
    tar -xzf /tmp/mongodb.tgz -C /opt/mongodb --strip-components=1; \
    rm /tmp/mongodb.tgz; \
    mkdir -p /var/log/supervisor

ENV PATH="/opt/mongodb/bin:${PATH}"

# Copy app runtime files
COPY package*.json ./
RUN npm install --omit=dev --legacy-peer-deps
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server.js ./server.js
COPY --from=builder /app/public ./public

# Copy Supervisor config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose ports
EXPOSE 3000

# Healthcheck: ensure mongod is listening and /health reports connected
HEALTHCHECK --interval=10s --timeout=3s --start-period=25s --retries=12 \
  CMD nc -z 127.0.0.1 27017 \
    && curl -fsS http://127.0.0.1:3000/health | grep -q '"mongo":"connected"' || exit 1

# Volumes for persistence
VOLUME ["/data/db", "/app/uploads"]

# Default environment: server.js will default MONGO_URI to 127.0.0.1
ENV PORT=3000

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
