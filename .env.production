# Production Environment Configuration
# 
# For production deployments, do NOT set VITE_SOCKET_URL to localhost
# The app will automatically detect the current domain and use it for WebSocket connections
#
# If deploying to a custom domain, set it here:
# VITE_SOCKET_URL=https://your-production-domain.com

# MongoDB URI - adjust for your production setup
MONGO_URI=mongodb://127.0.0.1:27017/chatapp

# Optional: restrict allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Optional: admin token for future admin features
# ADMIN_TOKEN=change-me-strong