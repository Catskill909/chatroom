# Example environment variable for Socket.IO backend URL
# For LOCAL DEVELOPMENT ONLY (when frontend and backend run on different ports):
# VITE_SOCKET_URL=http://localhost:3000

# For PRODUCTION DEPLOYMENT: 
# DO NOT set VITE_SOCKET_URL - let the app auto-detect the current domain
# OR set it to your production domain (e.g., https://chat.yourdomain.com)
# VITE_SOCKET_URL=https://chat.yourdomain.com

# MongoDB connection string for backend server
# For local dev:
# MONGO_URI=mongodb://localhost:27017/chatapp
# For Docker Compose (container networking):
# MONGO_URI=mongodb://mongodb:27017/chatapp

# For All-in-One single-container (Dockerfile.allinone):
# Leave MONGO_URI unset. server.js defaults to mongodb://127.0.0.1:27017/chatapp inside the container.

# Optional: restrict allowed origins for CORS (comma-separated). Defaults to '*'
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Optional: admin token for future admin features (not required yet)
# ADMIN_TOKEN=change-me-strong
